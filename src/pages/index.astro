---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { BUSINESS_NAME } from "../utils/constants";

const features = [
  {
    title: "Reservation-grade availability",
    description: "Guests see open tasting windows from Wix Bookings, keeping the reservation calendar in sync with the restaurant.",
    label: "Tables",
  },
  {
    title: "Paid tasting flow",
    description: "No-fee inquiries and paid tasting reservations can use the same front end while Wix handles service type and checkout.",
    label: "Tastings",
  },
  {
    title: "Guest-ready confirmation",
    description: "The reservation summary keeps name, time, and contact details easy for guests to review after booking.",
    label: "Details",
  },
];

const tastings = [
  {
    title: "Tasting Inquiry",
    detail: "30 min / no-fee",
    description: "A planning conversation for guests choosing the right evening, party size, or occasion.",
  },
  {
    title: "Chef's Counter",
    detail: "60 min / paid",
    description: "A paid tasting reservation that can move from live slot selection into Wix checkout.",
  },
  {
    title: "Harbor Seating",
    detail: "live inventory",
    description: "Openings stay connected to the service calendar while the front end feels like the dining room.",
  },
];

const flow = ["Choose a tasting", "Select the opening", "Confirm guest details"];
---

<Layout>
  <div class="min-h-screen bg-white">
    <Navbar />

    <main>
      <section class="harbor-hero pt-28 pb-14 text-white md:pt-36 md:pb-20">
        <div class="max-w-7xl mx-auto grid gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_0.92fr] lg:items-center lg:px-8">
          <div class="animate-fade-up">
            <p class="mb-5 inline-flex rounded-lg border border-white/15 bg-white/10 px-3 py-2 text-sm font-semibold uppercase text-secondary/90">Tasting reservations by the harbor</p>
            <h1 class="max-w-4xl text-5xl font-semibold leading-[1.02] sm:text-6xl">
              Reserve the table, not just the time.
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-white/75">
              {BUSINESS_NAME} turns Wix Headless bookings into a guest-facing reservation ledger for tastings, chef's counter seats, and paid dining moments.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/schedule" class="inline-flex justify-center rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-[0_18px_44px_rgba(224,78,57,0.26)] transition-transform hover:-translate-y-0.5 hover:bg-accent/90">
                Reserve a Tasting
              </a>
              <a href="#tastings" class="inline-flex justify-center rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/20">
                Explore the Menu
              </a>
            </div>
            <div class="harbor-hero-flow mt-10">
              {flow.map((item, index) => (
                <div>
                  <span>{index + 1}</span>
                  <strong>{item}</strong>
                </div>
              ))}
            </div>
          </div>

          <div class="harbor-ledger animate-slide-in-right">
            <div class="harbor-ledger-header">
              <span>Tonight's ledger</span>
              <strong>6 seats open</strong>
            </div>
            <div class="harbor-reservation-row">
              <div>
                <strong>Harbor Tasting</strong>
                <p>Dining room / no-fee inquiry</p>
              </div>
              <time>6:00 PM</time>
            </div>
            <div class="harbor-reservation-row is-accent">
              <div>
                <strong>Chef's Counter</strong>
                <p>Paid tasting</p>
              </div>
              <time>8:30 PM</time>
            </div>
            <div class="harbor-reservation-row">
              <div>
                <strong>Window Table</strong>
                <p>service calendar synced</p>
              </div>
              <time>9:15 PM</time>
            </div>
            <div class="harbor-table-map" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <p class="harbor-ledger-note">Live Wix availability becomes a reservation surface that feels like the restaurant, not a generic form.</p>
          </div>
        </div>
      </section>

      <section id="tastings" class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-12 grid gap-6 md:grid-cols-[0.85fr_1fr] md:items-end">
            <div>
              <p class="text-sm font-semibold uppercase text-accent">From inquiry to seat</p>
              <h2 class="mt-3 text-3xl font-semibold text-primary md:text-5xl">A reservation system with dining-room character.</h2>
            </div>
            <p class="text-muted-foreground">
              The booking surface lets guests select a tasting path, compare real openings, and confirm details while Wix remains the system of record.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {tastings.map((tasting) => (
              <article class="harbor-tasting-card">
                <p>{tasting.detail}</p>
                <h3>{tasting.title}</h3>
                <span>{tasting.description}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="harbor-capability-section py-16 md:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-10 max-w-3xl">
            <p class="text-sm font-semibold uppercase text-accent">Wix behind the service</p>
            <h2 class="mt-3 text-3xl font-semibold text-primary md:text-4xl">Guest polish up front, service inventory behind every selection.</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {features.map((feature, index) => (
              <div class="harbor-feature-card animate-fade-up" style={`animation-delay: ${index * 100 + 200}ms`}>
                <p class="mb-8 text-xs font-semibold uppercase text-accent">{feature.label}</p>
                <h3 class="text-xl font-semibold mb-3 text-primary">{feature.title}</h3>
                <p class="text-muted-foreground">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-16 bg-secondary">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
            <div class="animate-fade-up">
              <p class="text-sm font-semibold uppercase text-primary/70">The next table is visible</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-semibold text-primary md:text-5xl">Invite guests into the reservation before they reach the restaurant.</h2>
            </div>
            <a href="/schedule" class="inline-flex justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary/90 animate-fade-up" style="animation-delay: 120ms;">
              Open Reservations
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
