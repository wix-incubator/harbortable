---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import DatePicker from "../components/DatePicker.astro";
import TimeSlots from "../components/TimeSlots.astro";
import BookingForm from "../components/BookingForm.astro";
import SessionType from "../components/SessionType.astro";
import BackButton from "../components/ui/BackButton.astro";
import "../styles/global.css";
import { BUSINESS_NAME } from "../utils/constants";
---

<Layout>
  <div class="min-h-screen bg-[#f4f8fa]">
    <Navbar />

    <div class="max-w-7xl mx-auto pt-28 pb-16 px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <BackButton href="/" text="Back to Home" />
      </div>

      <section class="harbor-schedule-header mb-8 animate-fade-up">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase text-secondary/80">Reservation desk</p>
          <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-white md:text-5xl">
            Reserve a tasting at {BUSINESS_NAME}.
          </h1>
        </div>
        <p class="max-w-2xl text-base leading-7 text-white/70">
          Select an inquiry or paid tasting, then choose a live opening from Wix Bookings. The service catalog, reservation slot, and checkout path stay connected behind this branded dining flow.
        </p>
      </section>

      <div class="mb-8 grid gap-3 sm:grid-cols-3 animate-fade-up delay-100">
        <div class="rounded-lg bg-white p-4 shadow-xs">
          <p class="text-xs font-semibold uppercase text-accent">Tasting</p>
          <p class="mt-1 font-medium">Select the reservation path</p>
        </div>
        <div class="rounded-lg bg-white p-4 shadow-xs">
          <p class="text-xs font-semibold uppercase text-accent">Opening</p>
          <p class="mt-1 font-medium">Pick a live service time</p>
        </div>
        <div class="rounded-lg bg-white p-4 shadow-xs">
          <p class="text-xs font-semibold uppercase text-accent">Guest</p>
          <p class="mt-1 font-medium">Confirm the party details</p>
        </div>
      </div>

      <div class="max-w-2xl mx-auto mb-8 animate-fade-up delay-100">
        <SessionType />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="animate-fade-up delay-200">
          <DatePicker />
        </div>

        <div class="animate-fade-up delay-300">
          <TimeSlots />
        </div>

        <div id="booking-form" class="animate-fade-up delay-400">
          <BookingForm />
        </div>
      </div>
    </div>

    <Footer />
  </div>
</Layout>
