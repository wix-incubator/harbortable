---
import { BUSINESS_NAME } from '../utils/constants';

const currentYear = new Date().getFullYear();
---

<footer class="py-10 px-4 bg-primary text-white">
  <div class="max-w-7xl mx-auto flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-semibold">{BUSINESS_NAME}</p>
      <p class="mt-1 text-sm text-white/60">Wix Headless reservations for tasting menus, table inventory, and paid dining events.</p>
    </div>
    <p class="text-sm text-white/60">
      &copy; {currentYear} {BUSINESS_NAME}. Reserved by the water.
    </p>
  </div>
</footer>
